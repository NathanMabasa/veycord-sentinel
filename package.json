{
  "name": "veycord-sentinel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc --noEmit -p tsconfig.server.json && tsc -p tsconfig.runtime.json && vite build",
    "preview": "vite preview",
    "test:api": "tsx --test tests/api.test.ts",
    "start": "node --env-file-if-exists=.env.runtime build/server/node.js",
    "test:unit": "tsx --test tests/api.test.ts tests/private-api.test.ts tests/detections.test.ts tests/gateway.test.ts tests/runtime-config.test.ts",
    "test:db": "tsx --test tests/postgres.test.ts",
    "db:bootstrap": "node --env-file-if-exists=.env --import tsx db/bootstrap-runtime-role.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx db/seed-synthetic.ts",
    "db:retention": "node --env-file-if-exists=.env --import tsx db/retention.ts",
    "db:backup": "node --env-file-if-exists=.env --import tsx db/backup.ts",
    "db:restore": "node --env-file-if-exists=.env --import tsx db/restore.ts",
    "test:recovery": "tsx --test tests/backup.test.ts",
    "db:limits": "node --env-file-if-exists=.env --import tsx db/limits.ts",
    "config:runtime": "node --env-file-if-exists=.env scripts/create-runtime-env.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "gsap": "^3.15.0",
    "hono": "^4.13.13",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NathanMabasa/veycord-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/NathanMabasa/veycord-sentinel/issues"
  }
}
