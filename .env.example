# Copy to .env and replace every placeholder with generated, URL-encoded values.
# This file contains placeholders only. Keep the real .env out of version control.
POSTGRES_PASSWORD=replace-with-a-generated-admin-secret
SENTINEL_APP_PASSWORD=replace-with-a-different-generated-runtime-secret-at-least-32-chars
DATABASE_ADMIN_URL=postgresql://postgres:replace-with-a-generated-admin-secret@127.0.0.1:54329/veycord?sslmode=disable
DATABASE_ADMIN_ALLOW_LOCAL_INSECURE=true
DATABASE_URL=postgresql://sentinel_app:replace-with-a-different-generated-runtime-secret-at-least-32-chars@127.0.0.1:54329/veycord?sslmode=disable
SENTINEL_ALLOW_LOCAL_DATABASE=true
SENTINEL_PRIVATE_ENABLED=false
SENTINEL_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
SENTINEL_API_TOKEN=replace-with-a-generated-43-character-base64url-token

# Optional private account access. Disabled by default; see docs/IDENTITY.md.
SENTINEL_AUTH_ENABLED=false
SENTINEL_AUTH_ORIGIN=http://127.0.0.1:5173
SENTINEL_AUTH_ALLOW_LOCAL=true
SENTINEL_AUTH_SECRET=replace-with-independent-generated-43-character-base64url-secret
SENTINEL_AUTH_RUNTIME_PASSWORD=replace-with-another-generated-43-character-base64url-secret
SENTINEL_AUTH_DATABASE_URL=postgresql://sentinel_identity_app:replace-with-identity-runtime-password@127.0.0.1:54329/veycord?sslmode=disable
